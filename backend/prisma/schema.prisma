// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model Product {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  price       Decimal  @db.Decimal(10, 2)
  oldPrice    Decimal? @db.Decimal(10, 2)
  category    String?
  tag         String?
  stock       Int      @default(0)
  imageUrl    String?
  images      ProductImage[]
  cartItems   CartItem[]
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  publicId  String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}



  enum Role {
  USER
  ADMIN
  STAFF
}


model User {
  id               String    @id @default(uuid())
  email            String    @unique
  name             String?
  password         String?
  phone            String?    @unique
  emailVerified    Boolean    @default(false)
  addresses        Address[]
  role             Role     @default(USER)
  cart             Cart?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  orders           Order[]
  checkoutSessions CheckoutSession[]
}

//email otp table 

enum OtpPurpose {
  SIGNUP
  LOGIN
  PASSWORD_RESET
  ORDER_CONFIRMATION
}

model EmailOTP{
  id               String    @id @default(uuid())
  email            String    
  otpHash          String
  purpose          OtpPurpose @default(SIGNUP)
  verified         Boolean   @default(false)

  expiresAt        DateTime
  attempts         Int      @default(0)
  maxAttempts      Int      @default(5)
  varifiedAt       DateTime?
  createdAt        DateTime   @default(now())
  metadata         Json?
   @@index([email])
  @@index([email, purpose])
}

//cart schema

model Cart {
    id                 String            @id @default(uuid())
    guestId            String?           @unique
    userId             String?           @unique
    user               User?             @relation(fields: [userId], references : [id], onDelete: Cascade)
    items              CartItem[]
    createdAt          DateTime          @default(now())
    updatedAt          DateTime          @updatedAt

}

model CartItem{

     id           String        @id @default(cuid())

    cartId        String
    cart          Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity        Int           @default(1)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([cartId, productId])

}


model CheckoutSession {
  id              String          @id @default(cuid())
  userId          String?
  user            User?             @relation(fields: [userId], references: [id] )
  guestId         String?

  status          CheckoutStatus  @default(ACTIVE)

  subtotal        Decimal         @db.Decimal(10,2)
  shipping        Decimal         @db.Decimal(10,2)
  total           Decimal         @db.Decimal(10,2)
  tax             Decimal         @db.Decimal(10,2)

  expiresAt       DateTime

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  items           CheckoutItem[]
  addressId       String?
  address         Address?        @relation(fields: [addressId] , references:[id])

  @@index([userId])
}

enum CheckoutStatus {
  ACTIVE
  PAYMENT_PENDING
  PAID
  EXPIRED
  CANCELLED
}



model CheckoutItem {
  id                String              @id @default(cuid())

  checkoutSessionId String
  checkoutSession   CheckoutSession     @relation(fields: [checkoutSessionId], references: [id])

  productId         String

  productName       String

  quantity          Int

  unitPrice         Decimal             @db.Decimal(10,2)

  createdAt         DateTime            @default(now())

  @@index([checkoutSessionId])
}

//address table 

model Address {
  id                String   @id @default(uuid())

  userId             String?
  user              User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName            String
  phone               String
  guestId            String?

  addressLine1        String
  landmark             String?

  city               String
  state              String
  country            String
  postalCode          String
  orders               Order[]
  isDefault           Boolean       @default(false)

  latitude             Decimal?      @db.Decimal(10,7)
  longitude            Decimal?     @db.Decimal(10,7)
  checkoutSessions    CheckoutSession[]

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

//order table 

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id              String        @id @default(uuid())

  orderNumber     String        @unique

  userId          String?
  user            User?         @relation(fields: [userId], references: [id])

  guestId         String?

  customerName    String
  customerEmail   String
  customerPhone   String

  addressId       String
  address         Address       @relation(fields: [addressId], references: [id])
  addressSnapshot Json?
  status          OrderStatus   @default(PENDING)

  paymentStatus   PaymentStatus @default(PENDING)

  subtotal        Decimal       @db.Decimal(10,2)
  tax             Decimal       @db.Decimal(10,2)
  shipping        Decimal       @db.Decimal(10,2)
  discount        Decimal       @default(0) @db.Decimal(10,2)

  total           Decimal       @db.Decimal(10,2)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           OrderItem[]
  payment         Payment?

  @@index([guestId])
}

//oder item 

model OrderItem {
  id            String   @id @default(uuid())

  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId     String

  productName   String

  quantity      Int

  unitPrice     Decimal  @db.Decimal(10,2)

  totalPrice    Decimal  @db.Decimal(10,2)

  createdAt     DateTime @default(now())
}

//payment table 

enum PaymentGateway {
  RAZORPAY
}

enum PaymentRecordStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id                    String               @id @default(uuid())

  orderId               String               @unique
  order                 Order                @relation(fields: [orderId], references: [id])

  gateway               PaymentGateway

  razorpayOrderId       String?              @unique
  razorpayPaymentId     String?              @unique
  razorpaySignature     String?

  amount                Decimal              @db.Decimal(10,2)

  status                PaymentRecordStatus  @default(PENDING)

  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}